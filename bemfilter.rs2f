// -------------------------------------- Currensies ---------------------------------------
#define VAR_CURRENCIES ["Brimstone key", "Granite dust", "*cannonball", "*teleport", "*teleport scroll", "Gryphon feather", "Ecumenical key", "Ecumenical key shard", "Nihil shard", "Right skull half", "Left skull half", "Top of sceptre", "Bottom of sceptre", "Mossy key", "Giant key", "Numulite", "Unidentified * fossil", "Sunfire splinters", "Blood essence", "Grubby key", "Crystal shard", "Zulrah's scales", "Tokkul", "Ancient shard", "Warrior guild token"]
#define VAR_CURRENCIES_RDT ["Loop half of key", "Tooth half of key", "Shield left half", "Crystal key", "Long bone", "Curved bone"]
#define VAR_CURRENCIES_WILDY ["Slayer's enchantment", "Larran's key", "Sinister key", "Revenant ether"]

#define VAR_RUNES_LOW ["Air rune", "Mind rune", "Water rune", "Earth rune", "Fire rune", "Body rune", "Nature rune", "Law rune", "Cosmic rune", "Mist rune", "Dust rune", "Mud rune", "Smoke rune", "Steam rune", "Lava rune"]
#define VAR_RUNES_HIGH ["Chaos rune", "Death rune", "Sunfire rune", "Astral rune", "Blood rune", "Soul rune", "Wrath rune", "Aether rune", "Aether catalyst"]

#define VAR_CURRENCIES_MAGGOT_KING ["Blood sac", "Venator fang", "Venator tooth"]
#define VAR_CURRENCIES_YAMA ["Dossier", "Oathplate shards", "Forgotten lockbox"]
#define VAR_CURRENCIES_MOLE ["Mole claw", "Mole skin"]
#define VAR_CURRENCIES_MOXY ["Frozen tear"]
#define VAR_CURRENCIES_HUEY ["Soiled page"]
#define VAR_CURRENCIES_MUSPAH ["Ancient essence", "Frozen cache"]
#define VAR_CURRENCIES_TITANS ["Desiccated page"]

#define VAR_CURRENCIES_PRAYER ["Infernal ashes", "Abyssal ashes", "Wyrm bones", "Strykewyrm bones", "Wyvern bones", "Dragon bones", "Drake bones", "Fayrg bones", "Lava dragon bones", "Raurg bones", "Frost dragon bones", "Hydra bones", "Dagannoth bones", "Ourg bones", "Superior dragon bones", "Loar remains", "Phrin remains", "Riyl remains", "Asyn remains", "Fiyr remains", "Urium remains", "Ensouled bloodveld head", "Ensouled tzhaar head", "Ensouled demon head", "Ensouled hellhound head", "Ensouled aviansie head", "Ensouled abyssal head", "Ensouled dragon head", "Giant bones", "Blessed bone shards", "Sun-kissed bones"]

#define CONST_CURRENCIES(_) ( \
	( \
		(stackable:true || noted:true || tradeable:false) && \
		( \
			name:VAR_CURRENCIES || \
			name:VAR_CURRENCIES_MAGGOT_KING || \
			name:VAR_CURRENCIES_YAMA || \
			name:VAR_CURRENCIES_MOLE || \
			name:VAR_CURRENCIES_MOXY || \
			name:VAR_CURRENCIES_MUSPAH || \
			name:VAR_CURRENCIES_HUEY || \
			name:VAR_CURRENCIES_TITANS \
		) \
	) || \
	( \
		name:VAR_CURRENCIES_RDT \
	) || \
	( \
		name:VAR_CURRENCIES_PRAYER \
	) || \
	( \
		name:VAR_CURRENCIES_WILDY \
	) \
)

#define CONST_RUNES(_) ( \
	stackable:true && \
	( \
		(name:VAR_RUNES_LOW && quantity:>=MIN_CURRENCIES_RUNES_LOW_LEVEL) || \
		(name:VAR_RUNES_HIGH && quantity:>=MIN_CURRENCIES_RUNES_HIGH_LEVEL) || \
		(name:["Pure essence"] && quantity:>MIN_CURRENCIES_RUNES_PURE_ESS) \
	) \
)

#define CONST_COINS(_) ( \
	name:"Coins" && quantity:>=MIN_CURRENCIES_COINS \
)

rule (CONST_CURRENCIES(0) || CONST_RUNES(0) || CONST_COINS(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_CURRENCIES;
	fontType=FONT_BOLD;
}

// -------------------------------------- End Currensies -----------------------------------
// -------------------------------------- Supplies -----------------------------------------
#define VAR_SUPPLIES_HEALTH ["Shark", "Marlin", "Monkfish", "Manta ray", "Anglerfish", "Yellowfin", "Cooked karambwan", "Pineapple pizza", "1/2 pineapple pizza", "Wild pie", "Half a wild pie", "Summer pie", "Half a summer pie", "Saradomin brew(*)", "Tuna potato", "Dark crab", "Blighted anglerfish", "Blighted karambwan", "Sea turtle", "Mushroom potato", "Egg potato"]
#define VAR_SUPPLIES_PRAYER ["Super restore mix(*)", "Prayer potion(*)", "Super restore(*)", "Blighted super restore(*)", "Sanfew serum(*)"]
#define VAR_SUPPLIES_STAT ["Super combat potion(*)", "Divine super combat potion(*)", "Salve amulet (e)", "Antidote++(*)", "Ranging potion(*)", "Divine ranging potion(*)", "Superantipoison(*)"]

#define VAR_SUPPLIES_PRAYER_MAGGOT_KING ["Dull ancient medal"] //Not usable outside the fight

// Only supplies which can help with the current fight
#define CONST_SUPPLIES_HEALTH_IN_FIGHT(_) ( \
	noted:false && \
	( \
		name:VAR_SUPPLIES_HEALTH \
	) \
)

#define CONST_SUPPLIES_PRAYER_IN_FIGHT(_) ( \
	noted:false && \
	( \
		name:VAR_SUPPLIES_PRAYER || \
		name:VAR_SUPPLIES_PRAYER_MAGGOT_KING \
	) \
)

#define CONST_SUPPLIES_STAT_IN_FIGHT(_) (\
	noted:false && \
	( \
		name:VAR_SUPPLIES_STAT \
	) \
)

// Noted supplies
#define CONST_SUPPLIES_HEALTH(_) ( \
	(stackable:true || noted:true) && \
	( \
		name:VAR_SUPPLIES_HEALTH || \
		name:"Raw*" \
	) \
)

#define CONST_SUPPLIES_PRAYER(_) ( \
	(stackable:true || noted:true) && \
	( \
		name:VAR_SUPPLIES_PRAYER \
	) \
)

#define CONST_SUPPLIES_STAT(_) ( \
	(stackable:true || noted:true) && \
	( \
		name:VAR_SUPPLIES_STAT \
	) \
)

rule (CONST_SUPPLIES_HEALTH_IN_FIGHT(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_HEALTH;
	fontType=FONT_BOLD;
	menuSort=999;
}

rule (CONST_SUPPLIES_PRAYER_IN_FIGHT(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_PRAYER;
	fontType=FONT_BOLD;
	menuSort=888;
}

rule (CONST_SUPPLIES_STAT_IN_FIGHT(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_STAT_BOOST;
	fontType=FONT_BOLD;
	menuSort=777;
}

rule (CONST_SUPPLIES_HEALTH(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_HEALTH;
	fontType=FONT_NORMAL;
}

rule (CONST_SUPPLIES_PRAYER(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_PRAYER;
	fontType=FONT_NORMAL;
}

rule (CONST_SUPPLIES_STAT(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SUPPLIES_STAT_BOOST;
	fontType=FONT_NORMAL;
}
