meta { 
	name = "Bem's filter"; 
	description = "Late-mid game+ iron filter.
All notable resources (besides some too low lvl ones) are in.
Clue rewards and most of other clogs going directly into inventory are not tracked.

Possibly left: furs? 
"; 
}

// Sound IDs https://oldschool.runescape.wiki/w/List_of_sound_IDs
// Area map https://mejrs.github.io/osrs [SW, NE] tiles

#define MIN_RESOURCES_GENERAL 10
#define MIN_RESOURCES_AMMO_COOKING 20
#define MIN_RESOURCES_RARE 5
#define MIN_HERBLORE_LOW_LEVEL 3
#define MIN_HERBLORE_SECONDARIES 5
#define MIN_HERBLORE_HIGH_LEVEL 1
#define MIN_FARMING_LOW_LEVEL 3
#define MIN_FARMING_HIGH_LEVEL 1
#define MIN_CURRENCIES_RUNES_LOW_LEVEL 200
#define MIN_CURRENCIES_RUNES_HIGH_LEVEL 50
#define MIN_CURRENCIES_RUNES_PURE_ESS 150
#define MIN_CURRENCIES_COINS 10_000
#define MIN_HA_THRESHOLD 10_000

#define FONT_SMALL 1
#define FONT_NORMAL 2
#define FONT_BOLD 3

#define ACCOUNT_MAIN 0

#define CONST_AREA_COX [3200, 5120, 0, 3391, 5759, 3]
#define CONST_AREA_TOB [3136, 4224, 0, 3327, 4479, 3]
#define CONST_AREA_TOA [3520, 5120, 0, 3967, 5439, 3]
#define CONST_AREA_RAID(_) (area:CONST_AREA_COX || area:CONST_AREA_TOB || area:CONST_AREA_TOA)
#define CONST_TAKEABLE(_) (accountType:ACCOUNT_MAIN || !ownership:OWNERSHIP_OTHER)

#define CONST_COLOR_RESOURCES "#1e88e5"
#define CONST_COLOR_SEEDS "#cffb2b"
#define CONST_COLOR_HUNTER_SUPPLIES "#07f70b"
#define CONST_COLOR_HERB_SUPPLIES "#11ba93"
#define CONST_COLOR_CURRENCIES "#2ce51e"
#define CONST_COLOR_SUPPLIES_HEALTH "#ffff00"
#define CONST_COLOR_SUPPLIES_PRAYER "#00f4ff"
#define CONST_COLOR_SUPPLIES_STAT_BOOST "#ff00ff"
#define CONST_COLOR_UNIQUES "#ffff66b2"

#define VAR_OWNERSHIP_IGNORE ["Dawnbringer"]
// Rock near the mogre camp, required to go into the area, used in elite clues
#define VAR_RANDOM_ITEMS_IDS [7533]

#define VAR_GLOBAL_HIDE ["Adamant arrow*"]
#define VAR_GLOBAL_SHOW []

rule (name:VAR_GLOBAL_HIDE) {
    hidden = true;
}

rule (name:VAR_GLOBAL_SHOW || id:VAR_RANDOM_ITEMS_IDS) {
    hidden = false;
}

rule (!CONST_TAKEABLE(0) && !name:VAR_OWNERSHIP_IGNORE) {
	hidden = true;
}

rule (!CONST_AREA_RAID(0) && ownership:OWNERSHIP_NONE && !name:VAR_OWNERSHIP_IGNORE) {
	hidden = true;
}
// -------------------------------------- Clues --------------------------------------------

#define VAR_CLUE_WILDERNESS_HARD_IDS [2723,2725,2727,2729,2731,2733,2735,2737,2739,2741,2743,2745,2747,2786,2788,3525,3556,3558,7239,7260,7262,7264,10244,10234,12546,12564,19888,23168,23169]
#define VAR_CLUE_WILDERNESS_ELITE_IDS [12075,12093,12095,12097,12109,12101,12134,12150,19807,23144,23146]
#define VAR_CLUE_ENTRANA_IDS []
#define VAR_CLUE_MEDIUM_ITEMS_NAMES ["Key (medium)"]
#define VAR_CLUE_ELITE_ITEMS_NAMES ["Mangled bones", "Key (elite)"] 

apply (name:["Clue scroll (beginner)", "Clue bottle (beginner)", "Clue nest (beginner)", "Clue geode (beginner)", "Scroll box (beginner)", "Reward casket (beginner)", "Challenge scroll (beginner)"]) {
	hidden=false;
	textColor="#ffbf9bbf";
	backgroundColor="#99333333";
	borderColor="#ffbf9bbf";
}

apply (name:["Clue scroll (easy)", "Clue bottle (easy)", "Clue nest (easy)", "Clue geode (easy)", "Scroll box (easy)", "Reward casket (easy)", "Challenge scroll (easy)"]) {
	hidden=false;
	textColor="#ff00a33c";
	backgroundColor="#99333333";
	borderColor="#ff00a33c";
}

apply (name:["Clue scroll (medium)", "Clue bottle (medium)", "Clue nest (medium)", "Clue geode (medium)", "Scroll box (medium)", "Reward casket (medium)", "Challenge scroll (medium)"] || name:VAR_CLUE_MEDIUM_ITEMS_NAMES) {
	hidden=false;
	textColor="#ff52c7de";
	backgroundColor="#99333333";
	borderColor="#ff52c7de";
}

apply (name:["Clue scroll (hard)", "Clue bottle (hard)", "Clue nest (hard)", "Clue geode (hard)", "Scroll box (hard)", "Reward casket (hard)", "Challenge scroll (hard)"]) {
	hidden=false;
	textColor="#ffab43f0";
	backgroundColor="#99333333";
	borderColor="#ffab43f0";
}

apply (name:["Clue scroll (elite)", "Clue bottle (elite)", "Clue nest (elite)", "Clue geode (elite)", "Scroll box (elite)", "Reward casket (elite)", "Challenge scroll (elite)"] || name:VAR_CLUE_ELITE_ITEMS_NAMES) {
	hidden=false;
	textColor="#ffe6ad29";
	backgroundColor="#99333333";
	borderColor="#ffe6ad29";
}

apply (name:["Challenge scroll (elite)"]) {
	fontType=FONT_BOLD;
}

// Elite Jardic step
apply (id:21524) {
	fontType=FONT_BOLD;
	showLootbeam=true;
}

apply (name:["Scroll box (*)", "Reward casket (*)", "Mimic"]){
	sound=1458;
}

apply (name:["Clue scroll (master)", "Clue bottle (master)", "Clue nest (master)", "Clue geode (master)", "Scroll box (master)", "Reward casket (master)", "Challenge scroll (master)", "Mimic"]) {
	hidden=false;
	textColor="#ffc90808";
	backgroundColor="#99333333";
	borderColor="#ffc90808";
}

rule (id:VAR_CLUE_WILDERNESS_HARD_IDS || id:VAR_CLUE_WILDERNESS_ELITE_IDS) {
	hidden=false;
	borderColor="#ffff0000";
	menuTextColor="#ffff0000";
}

rule (name:["Clue scroll*", "Clue bottle*", "Clue nest*", "Clue geode*", "Scroll box*", "Reward casket (*)", "Challenge scroll (*)"] || name: VAR_CLUE_ELITE_ITEMS_NAMES || name:VAR_CLUE_MEDIUM_ITEMS_NAMES) {
}
// -------------------------------------- End Clues ----------------------------------------
// -------------------------------------- Resources ----------------------------------------
// General items, only care about noted
#define VAR_G_GEMS ["Uncut sapphire", "Uncut emerald", "Uncut ruby", "Uncut diamond", "Uncut opal", "Uncut jade", "Uncut red topaz", "Sapphire", "Emerald", "Ruby", "Diamond", "Opal", "Jade", "Red topaz"]
#define VAR_G_ORES ["Copper ore", "Tin ore", "Iron ore", "Silver ore", "Lead ore", "Coal", "Gold ore", "Mithril ore", "Nickel ore"]
#define VAR_G_LOGS ["Maple logs", "Yew logs", "Magic logs", "Redwood logs", "Teak logs", "Mahogany logs", "Camphor logs", "Ironwood logs", "Rosewood logs"]
#define VAR_G_AMMO ["Runite bolts (unf)", "Runite bolts", "Rune dart tip", "Rune dart", "Rune arrowtips", "Rune arrow", "Rune javelin tips", "Rune javelin"]
#define VAR_G_CRAFTING ["Bucket of sand", "Green dragonhide", "Blue dragonhide", "Red dragonhide", "Air orb", "Earth orb", "Fire orb", "Water orb", "Molten glass", "Flax", "Swamp tar"]
#define VAR_G_COOKING ["Grapes"]

// Rare items
#define VAR_R_GEMS ["Uncut dragonstone", "Uncut onyx", "Uncut zenyte", "Dragonstone", "Onyx", "Zenyte"]
#define VAR_R_ORES ["Adamantite ore", "Runite ore"]
#define VAR_R_FISHING ["Shark lure", "Diabolic worms", "Spirit flakes", "Fish offcuts", "Fine fish offcuts"]
#define VAR_R_AMMO ["Dragon bolts (unf)", "Dragon bolts", "Dragon dart tip", "Dragon dart", "Dragon arrowtips", "Dragon arrow", "Onyx bolt tips", "Onyx bolts", "Onyx bolts (e)", "Dragon javelin tips", "Dragon javelin", "Toktz-xil-ul"]
#define VAR_R_CRAFTING ["Black dragonhide"]
#define VAR_R_SINGLE_DROP_RESOURCES ["Broken antler"]

// Golem crafting
#define CONST_AREA_WYRMSCRAIG_GOLEMS [2586, 2238, 0, 2603, 2261, 3]
rule(area:CONST_AREA_WYRMSCRAIG_GOLEMS && (name:VAR_G_GEMS || name:["Sunstone", "Sunstone core"])) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_RESOURCES;
	fontType=FONT_SMALL;
}

#define CONST_GENERAL_RESOURCES(_) ( \
	(stackable:true || noted:true) && \
	( \
		quantity:>=MIN_RESOURCES_GENERAL &&  \
		( \
			name:VAR_G_GEMS || \
			name:VAR_G_ORES || \
			name:VAR_G_LOGS || \
			name:VAR_G_CRAFTING \
		) \
	) || \
	( \
		quantity:>=MIN_RESOURCES_AMMO_COOKING && \
		( \
			name:VAR_G_AMMO || \
			name:VAR_G_COOKING \
		) \
	) \
) 

#define CONST_RARE_RESOURCES(_) ( \
	(stackable:true || noted:true) && \
	(\
		quantity:>=MIN_RESOURCES_RARE && \
		( \
			name:VAR_R_GEMS || \
			name:VAR_R_ORES || \
			name:VAR_R_FISHING || \
			name:VAR_R_CRAFTING || \
			name:VAR_R_AMMO \
		) \
	) || \
	(\
		name:VAR_R_SINGLE_DROP_RESOURCES \
	)\
)

#define CONST_UNSTACKABLE_RARE_RESOURCES(_) ( \
	name:VAR_R_GEMS \
) 

rule (CONST_GENERAL_RESOURCES(0) || CONST_RARE_RESOURCES(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_RESOURCES;
	fontType=FONT_NORMAL;
}

rule (CONST_UNSTACKABLE_RARE_RESOURCES(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_RESOURCES;
	fontType=FONT_BOLD;
}

// Other potential unstackables
// -------------------------------------- End Resources ------------------------------------
// -------------------------------------- Hunter -------------------------------------------
#define VAR_HUNTER []
#define VAR_HUNTER_MAGGOT_KING ["Stymphike feather", "Letvek"]

#define CONST_HUNTER(_) ( \
	name:VAR_HUNTER || \
	name:VAR_HUNTER_MAGGOT_KING \
)

rule (CONST_HUNTER(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_HUNTER_SUPPLIES;
	fontType=FONT_SMALL;
}

// -------------------------------------- End Hunter ---------------------------------------
// -------------------------------------- Herblore -----------------------------------------
#define VAR_HERB_LV ["Grimy guam leaf", "Guam leaf", "Grimy marrentill", "Marrentill", "Grimy tarromin", "Tarromin", "Grimy harralander", "Harralander", "Grimy irit leaf", "Irit leaf", "Grimy avantoe", "Avantoe", "Grimy kwuarm", "Kwuarm", "Grimy cadantine", "Cadantine", "Grimy Lantadyme", "Lantadyme", "Grimy dwarf weed", "Dwarf weed", "Limpwurt root", "Araxyte venom sac"]
#define VAR_HERB_RARE ["Grimy ranarr weed", "Ranarr weed", "Grimy toadflax", "Toadflax", "Grimy huasca", "Huasca", "Grimy Snapdragon", "Snapdragon", "Grimy torstol", "Torstol", "Snape grass"]
#define VAR_HERB_UNSTACKABLE ["Barrel of demonic tallow*", "Grapevine", "Bird nest", "Giant egg sac*", "Scaly blue dragonhide", "Alchemist's signet"]
#define VAR_HERB_SECONDARIES ["Potato cactus", "White berries", "Unicorn horn", "Mort myre fungus", "Wine of zamorak", "Red spiders' eggs", "Coconut"]

#define CONST_HERB_STACKABLE_LV(_) ( \
	(stackable:true || noted:true) && \
	( \
		quantity:>=MIN_HERBLORE_LOW_LEVEL && \
		( \
			name:VAR_HERB_LV \
		) \
	) || \
	( \
		quantity:>=MIN_HERBLORE_SECONDARIES && \
		( \
			name:VAR_HERB_SECONDARIES \
		) \
	) \
)

#define CONST_HERB_STACKABLE_RARE(_) ( \
	(stackable:true || noted:true) && \
	quantity:>=MIN_HERBLORE_HIGH_LEVEL && \
	( \
		name:VAR_HERB_RARE \
	) \
)

#define CONST_HERB_UNSTACKABLE(_) ( \
	name:VAR_HERB_UNSTACKABLE \
)

apply(CONST_HERB_STACKABLE_LV(0)) {
	fontType=FONT_NORMAL;
}

apply (CONST_HERB_STACKABLE_RARE(0) || CONST_HERB_UNSTACKABLE(0)) {
	fontType=FONT_BOLD;
}

rule (CONST_HERB_STACKABLE_LV(0) || CONST_HERB_STACKABLE_RARE(0) || CONST_HERB_UNSTACKABLE(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_HERB_SUPPLIES;
}

// -------------------------------------- End Herblore -------------------------------------
// -------------------------------------- Farming ------------------------------------------
#define VAR_SEEDS_LV_HERB ["Guam seed", "Marrentill seed", "Tarromin seed", "Harralander seed", "Irit seed", "Avantoe seed", "Kwuarm seed", "Cadantine seed", "Lantadyme seed", "Dwarf weed seed"]
#define VAR_SEEDS_LV_GENERAL ["Watermelon seed", "Grapes seed", "Mushroom spore", "Elkhorn frag", "Pillar frag", "Hemp seed", "Cotton seed", "Limpwurt seed"]
#define VAR_SEEDS_LV_FARM ["Maple seed", "Teak seed", "Pineapple seed", "Papaya seed"]

#define VAR_SEEDS_HERB ["Ranarr seed", "Toadflax seed", "Snapdragon seed", "Huasca seed", "Torstol seed", "Snape grass seed"]
#define VAR_SEEDS_GENERAL ["White lily seed", "Seaweed spore", "Belladonna seed", "Hespori seed", "Umbral frag"]
#define VAR_SEEDS_FARM ["Yew seed", "Magic seed", "Mahogany seed", "Camphor seed", "Ironwood seed", "Rosewood seed", "Calquat tree seed", "Crystal acorn", "Spirit seed", "Celastrus seed", "Redwood tree seed", "Palm tree seed", "Dragonfruit tree seed"]
#define VAR_SEEDS_SUPPLEMENTS ["Supercompost"]

#define CONST_SEEDS_LV(_) ( \
	(stackable:true || noted:true) && \
	quantity:>=MIN_FARMING_LOW_LEVEL && ( \
		name:VAR_SEEDS_LV_HERB || \
		name:VAR_SEEDS_LV_GENERAL || \
		name:VAR_SEEDS_LV_FARM \
	) \
)

#define CONST_SEEDS_RARE(_) ( \
	(stackable:true || noted:true) && \
	quantity:>=MIN_FARMING_HIGH_LEVEL && ( \
		name:VAR_SEEDS_HERB || \
		name:VAR_SEEDS_GENERAL || \
		name:VAR_SEEDS_FARM || \
		name:VAR_SEEDS_SUPPLEMENTS \
	) \
) 

apply(CONST_SEEDS_LV(0)) {
	fontType=FONT_NORMAL;
}

apply (CONST_SEEDS_RARE(0)) {
	fontType=FONT_BOLD;
}

rule (CONST_SEEDS_LV(0) || CONST_SEEDS_RARE(0)) {
	hidden=false;
	showDespawn=true;
	textColor=CONST_COLOR_SEEDS;
}
