// Uniques, but really not care about them
#define VAR_LV_UNIQUES ["Dragon 2h sword", "Dragon sword", "Dragon pickaxe", "Dragon chainbody", "Looting bag", "Ancient staff", "*defender", "Ancient page", "Mark of Grace"]

